# syntax=docker/dockerfile:1
#
# EXPERIMENTAL riscv64 build of Hermes. NOT a drop-in for the production
# multi-arch Dockerfile — it is a standalone variant meant to be built
# natively on real riscv64 hardware (e.g. Banana Pi F3 / SpacemiT K1) so we
# can discover, one layer at a time, where a riscv64 image actually breaks.
#
#   docker build -f Dockerfile.riscv64 -t hermes:riscv64 .
#
# Why a separate file instead of TARGETARCH branches in the main Dockerfile:
# the production image sources `uv` and `node` via `COPY --from=<image>`
# stages whose manifests have no riscv64 variant, and a Dockerfile COPY
# cannot be made conditional on an ARG. Rather than restructure (and risk)
# the working amd64/arm64 build, this variant downloads those two binaries
# directly. Once it builds and runs on hardware, the deltas can be folded
# back into Dockerfile with a multi-stage select.
#
# Known divergences from Dockerfile (all marked `# riscv64:` below):
#   1. No uv_source / node_source FROM stages — uv and node are fetched as
#      checksum-pinned tarballs (uv from GitHub, node from unofficial-builds
#      because nodejs.org/dist ships no riscv64 binary).
#   2. s6-overlay uses the upstream riscv64 tarball.
#   3. A Rust + C build toolchain is installed because there are no
#      manylinux riscv64 wheels for the native deps (pydantic-core,
#      tokenizers, cryptography, numpy, pynacl, …) — uv compiles them from
#      sdist. Expect this layer to be slow even on native hardware.
#   4. Playwright Chromium is NOT installed: no riscv64 browser build exists
#      upstream. Browser-automation features are unavailable in this image.
#   5. The web dashboard is NOT built in-image. Tailwind v4's Vite pipeline
#      pulls lightningcss + @tailwindcss/oxide, Rust/napi modules with no
#      riscv64 binary on npm, and there is no riscv64 `node` base image to
#      build them under anyway (node:22 has no riscv64 manifest). The
#      dashboard output (hermes_cli/web_dist) is arch-independent static
#      assets, so it is built once on amd64 and injected via the build
#      context; absent that, the image ships dashboard-less (the dashboard
#      service is gated off by default). See the web_dist note before the
#      source COPY below.
#
#   6. Python 3.14 comes from python-build-standalone's riscv64 build, pinned
#      to the same release upstream's pm/lock.json uses. Upstream supports
#      3.14 only (every dependency is gated on python_version >= '3.14') and
#      Debian trixie ships 3.13.
#   7. Upstream's `pm` provisioner (uv, node, Chromium, ffmpeg, ripgrep, the
#      pm-runtime and the `docker.build_agent` assembly step) is skipped:
#      pm.store.current_target() raises on any arch other than x64/arm64.
#      The project is linked with an editable install instead, as before, and
#      opt-in extras that upstream installs lazily at first use through pm
#      are unavailable; only the extras baked in at build time work.
#   8. The desktop Webapp bundle (apps/desktop/dist-webapp) is not built.
#
# Debian trixie is an official RISC-V port, so the runtime base is unchanged.

FROM debian:13.4

# Disable Python stdout buffering to ensure logs are printed immediately
ENV PYTHONUNBUFFERED=1

# Store Playwright browsers outside the volume mount so the build-time
# install survives the /opt/data volume overlay at runtime. Kept for parity
# even though no browser is installed on riscv64 (see divergence #4).
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/hermes/.playwright

# Install system dependencies in one layer, clear APT cache.
# riscv64: extra packages vs the production Dockerfile —
#   make g++            : node-gyp compiles native npm addons from source
#                         (no riscv64 prebuilds) and needs a full C/C++ chain.
#   pkg-config libssl-dev: cryptography's Rust build links system OpenSSL.
#   libjpeg62-turbo-dev zlib1g-dev libheif-dev:
#                         Pillow and pillow-heif have no riscv64 wheel and
#                         build from sdist against these headers.
#   libolm-dev          : Matrix E2EE (python-olm via mautrix[encryption]) is a
#                         runtime lazy-install with no riscv64 wheel, so it
#                         compiles from sdist and needs the olm headers (parity
#                         with the production Dockerfile).
# Rust itself comes from rustup (installed below), NOT Debian: trixie ships
# rustc 1.85.0, which is too old for `davey` (Discord DAVE voice E2EE via the
# openmls crate) — openmls uses `unsigned_is_multiple_of`, stabilized in Rust
# 1.87. The maturin/Cython builds of cffi, pynacl, uvloop, httptools, jiter,
# cryptography, watchfiles, etc. all run against the rustup toolchain.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates curl iputils-ping ripgrep ffmpeg \
    gcc g++ make libffi-dev libolm-dev procps git openssh-client \
    docker-cli xz-utils pkg-config libssl-dev \
    libjpeg62-turbo-dev zlib1g-dev libheif-dev && \
    rm -rf /var/lib/apt/lists/*

# ---------- s6-overlay install ----------
# riscv64: upstream s6-overlay publishes a first-class riscv64 tarball, so
# this is the same flow as the production image with the arch hardcoded and
# the riscv64 checksum pinned (fetched from the v3.2.3.0 .sha256 assets).
ARG S6_OVERLAY_VERSION=3.2.3.0
ARG S6_OVERLAY_NOARCH_SHA256=b720f9d9340efc8bb07528b9743813c836e4b02f8693d90241f047998b4c53cf
ARG S6_OVERLAY_RISCV64_SHA256=a4a4ed5eb17562879d07189cc4b3b9cd146c2d88855792fa95d99e0decbfcaf8
ARG S6_OVERLAY_SYMLINKS_SHA256=a60dc5235de3ecbcf874b9c1f18d73263ab99b289b9329aa950e8729c4789f0e
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz /tmp/
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-symlinks-noarch.tar.xz /tmp/
RUN set -eu; \
    curl -fsSL --retry 3 -o /tmp/s6-overlay-arch.tar.xz \
        "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-riscv64.tar.xz"; \
    { \
        printf '%s  %s\n' "${S6_OVERLAY_NOARCH_SHA256}" /tmp/s6-overlay-noarch.tar.xz; \
        printf '%s  %s\n' "${S6_OVERLAY_RISCV64_SHA256}" /tmp/s6-overlay-arch.tar.xz; \
        printf '%s  %s\n' "${S6_OVERLAY_SYMLINKS_SHA256}" /tmp/s6-overlay-symlinks-noarch.tar.xz; \
    } > /tmp/s6-overlay.sha256; \
    sha256sum -c /tmp/s6-overlay.sha256; \
    tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz; \
    tar -C / -Jxpf /tmp/s6-overlay-arch.tar.xz; \
    tar -C / -Jxpf /tmp/s6-overlay-symlinks-noarch.tar.xz; \
    rm /tmp/s6-overlay-*.tar.xz /tmp/s6-overlay.sha256; \
    ln -sf /init /usr/bin/tini

# Non-root user for runtime; UID can be overridden via HERMES_UID at runtime
RUN useradd -u 10000 -m -d /opt/data hermes

# ---------- uv (riscv64) ----------
# riscv64: production copies uv from ghcr.io/astral-sh/uv (no riscv64
# manifest). Astral does publish a standalone riscv64 binary, so fetch and
# verify it. Tarball layout: uv-riscv64gc-unknown-linux-gnu/{uv,uvx}.
# Same uv version as upstream's pm/lock.json.
ARG UV_VERSION=0.13.5
ARG UV_RISCV64_SHA256=5c2692ecbf3a9d2c5955c403b30e61740b3ea2fdcc9b6eb533eeda268bf2b56d
RUN set -eu; \
    curl -fsSL --retry 3 -o /tmp/uv.tar.gz \
        "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-riscv64gc-unknown-linux-gnu.tar.gz"; \
    printf '%s  %s\n' "${UV_RISCV64_SHA256}" /tmp/uv.tar.gz | sha256sum -c; \
    tar -C /usr/local/bin --strip-components=1 -xzf /tmp/uv.tar.gz \
        uv-riscv64gc-unknown-linux-gnu/uv uv-riscv64gc-unknown-linux-gnu/uvx; \
    chmod 0755 /usr/local/bin/uv /usr/local/bin/uvx; \
    rm /tmp/uv.tar.gz; \
    uv --version

# ---------- Python 3.14 (riscv64, python-build-standalone) ----------
# riscv64: upstream gets this interpreter through pm, which has no riscv64
# target (divergence #7). python-build-standalone publishes the same release
# for riscv64; the non-stripped install_only tarball keeps the headers that
# the sdist builds below need. Symlinked to /usr/local/bin/python3 like
# upstream's image.
ARG PYTHON_RELEASE=3.14.9+20261021
ARG PYTHON_RISCV64_SHA256=b374284692dd4ef0cbfde99c434548fffea4c3e4fd9683b430d23ad0ecda64db
RUN set -eu; \
    tag="${PYTHON_RELEASE#*+}"; \
    curl -fsSL --retry 3 -o /tmp/python.tar.gz \
        "https://github.com/astral-sh/python-build-standalone/releases/download/${tag}/cpython-$(printf '%s' "${PYTHON_RELEASE}" | sed 's/+/%2B/')-riscv64-unknown-linux-gnu-install_only.tar.gz"; \
    printf '%s  %s\n' "${PYTHON_RISCV64_SHA256}" /tmp/python.tar.gz | sha256sum -c; \
    mkdir -p /opt/python; \
    tar -C /opt/python --strip-components=1 -xzf /tmp/python.tar.gz; \
    rm /tmp/python.tar.gz; \
    ln -s /opt/python/bin/python3 /usr/local/bin/python3; \
    ln -s /opt/python/bin/python3 /usr/local/bin/python; \
    python3 --version
# The standalone interpreter records its builder's clang toolchain (CC=clang,
# LDSHARED="clang -shared", AR=/tools/llvm/bin/llvm-ar); native extensions
# such as Pillow and PyNaCl must use the toolchain installed in this image.
ENV CC=gcc CXX=g++ AR=ar \
    LDSHARED="gcc -pthread -shared" LDCXXSHARED="g++ -pthread -shared"

# ---------- Node 26 (riscv64) ----------
# riscv64: nodejs.org/dist ships NO riscv64 binary. package.json requires
# node >=26 and npm <11.10.0 || >=11.17.0, and .npmrc sets engine-strict.
# The only Node 26 on unofficial-builds.nodejs.org for riscv64 is v26.0.0,
# whose npm 11.12.1 falls in the excluded range, so this takes v26.13.0
# (npm 11.20.0) from the gounthar/unofficial-builds fork. It must be the
# v26.13.0-lmulfix release: npm in the plain v26.13.0 (and in unofficial
# v26.0.0) dies with SIGILL on a SpaceMiT K1 (RVV, VLEN 256; nodejs/node#64538).
# That release adds the V8 LMUL fixes. Upstream pins 26.12.1.
# Extracting the whole prefix gives a complete, correctly-symlinked
# node/npm/npx/corepack install (and node headers for node-gyp).
ARG NODE_VERSION=26.13.0
ARG NODE_RELEASE_TAG=v26.13.0-lmulfix
ARG NODE_RISCV64_SHA256=0ffcf2ed6cf889b95ccc15c586cdc397bd9c26f9a9fd51980f27ad75b72407ec
RUN set -eu; \
    curl -fsSL --retry 3 -o /tmp/node.tar.xz \
        "https://github.com/gounthar/unofficial-builds/releases/download/${NODE_RELEASE_TAG}/node-v${NODE_VERSION}-linux-riscv64.tar.xz"; \
    printf '%s  %s\n' "${NODE_RISCV64_SHA256}" /tmp/node.tar.xz | sha256sum -c; \
    tar -C /usr/local --strip-components=1 \
        --exclude='*/CHANGELOG.md' --exclude='*/LICENSE' --exclude='*/README.md' \
        -xJf /tmp/node.tar.xz; \
    rm /tmp/node.tar.xz; \
    node --version && npm --version

# ---------- Rust toolchain (riscv64, rustup) ----------
# riscv64: Debian's rustc 1.85.0 can't build `davey`/openmls (needs the 1.87
# `unsigned_is_multiple_of`). rustup publishes a first-class riscv64gc host
# toolchain, so use it for every sdist that compiles Rust during `uv sync`.
# Installed system-wide under /usr/local so both the root build and the hermes
# user can reach cargo. The toolchain is pinned (RUST_VERSION) for reproducible
# builds — this is the version validated on hardware; it must stay >= 1.87 for
# openmls. The installer is downloaded to disk and then run (not piped into a
# shell) so a truncated download can't be masked by sh's lack of pipefail,
# matching the uv/node/s6 fetches above.
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:${PATH}
ARG RUST_VERSION=1.96.0
RUN set -eu; \
    curl --proto '=https' --tlsv1.2 -fsSL --retry 3 -o /tmp/rustup-init.sh https://sh.rustup.rs; \
    sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain "${RUST_VERSION}" --no-modify-path; \
    rm /tmp/rustup-init.sh; \
    chmod -R a+rX "${RUSTUP_HOME}" "${CARGO_HOME}"; \
    rustc --version && cargo --version

WORKDIR /opt/hermes

# ---------- Layer-cached dependency install ----------
# See production Dockerfile for the workspace-copy rationale; identical here.
COPY package.json package-lock.json ./
COPY web/package.json web/
COPY ui-tui/package.json ui-tui/
COPY ui-tui/packages/hermes-ink/ ui-tui/packages/hermes-ink/
COPY apps/shared/ apps/shared/

ENV npm_config_install_links=false

# riscv64: Playwright Chromium has no riscv64 build, so the production
# `npx playwright install --with-deps chromium` step is omitted — it would
# hard-fail. npm install still runs so the TUI and dashboard build inputs
# are present. Browser-automation features are disabled in this image.
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD guards any transitive postinstall that
# would otherwise try to pull a browser.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# riscv64: use `npm ci`, not `npm install`, and run it under `--predictable`.
#
# Two riscv64-only npm failures have been seen here, and both look like the
# same root cause: V8's parallel scavenger corrupting the heap on the
# unofficial riscv64 Node build. The symptom each time is type confusion,
# where an object of the wrong shape turns up somewhere the code proved it
# could not:
#
#   npm install: "Cannot read properties of undefined (reading 'os')"
#   npm ci:      "set.delete is not a function"
#
# The second one is the clearest evidence. `set.delete` is called in exactly
# two places in npm 10.9.8 (@npmcli/arborist inventory.js:109 and
# rebuild.js:253); both operate on a Set built by the caller, and the
# inventory.js one is already guarded by `if (set)`. There is no input that
# makes a real Set lack `.delete`, and JavaScript's single-threaded async
# concurrency cannot corrupt an object's shape either.
#
# It is also not reproducible off riscv64: the same lockfile and the same npm
# 10.9.8 install cleanly on amd64. And it is intermittent. Two builds 20
# minutes apart on an identical lockfile died 8.6s and 95.3s into the same
# `npm ci`, and an earlier build of that same lockfile succeeded outright.
#
# `--predictable` disables parallel GC, which is the workaround already known
# to fix V8 heap corruption on riscv64 (`vite build` hits it too). It costs
# build time on this layer. It has to be passed to node directly because node
# rejects it in NODE_OPTIONS ("--predictable is not allowed in NODE_OPTIONS"),
# hence invoking npm-cli.js rather than the `npm` shim. Upstream wraps this
# step in scripts/build/node-deps.mjs, which starts npm as a child process
# without the flag, so the same `npm ci` arguments it builds are passed here
# directly (ui-tui and web workspaces plus the root).
#
# `npm ci` is kept over `npm install` because it installs straight from
# package-lock.json and does far less work than `npm install` reconciliation,
# which narrows the window regardless of whether the GC theory holds.
# amd64/arm64 need none of this, which is why the production Dockerfile can
# use a plain `npm install`.
RUN node --predictable /usr/local/lib/node_modules/npm/bin/npm-cli.js ci \
        --no-audit --no-fund --engine-strict --include=dev --include=optional \
        --include-workspace-root=true --workspace ui-tui --workspace web && \
    npm cache clean --force

# ---------- Layer-cached Python dependency install ----------
# riscv64: this is THE expensive, failure-prone layer. With no manylinux
# riscv64 wheels available, `uv sync --frozen` builds every native extension
# from sdist using the Rust + C toolchains installed above. Expect long
# compiles and watch here first when the build fails — a missing sdist or an
# unbuildable crate surfaces at this step. As of v0.23.0 about 15 packages have
# no cp314 riscv64 wheel in uv.lock; the heavy ones are grpcio (C++),
# cryptography, resvg-py and firecrawl-anydoc (Rust), plus Pillow and
# pillow-heif.
#
# The extras are the same list as upstream's python_deps stage. Upstream runs
# them through `python3 -m pm.build_env --sealed`; pm has no riscv64 target
# (divergence #7), so this is the plain `uv sync --frozen` equivalent against
# the interpreter installed above. `[dev]` is a dependency group, not part of
# `[all]`, and --no-dev keeps it out as upstream does.
COPY pyproject.toml uv.lock ./
# pyproject.toml's `readme =` field points at README.md, which .dockerignore's
# `*.md` rule excludes from the build context. The `uv sync` step below stats
# that path while resolving deps, so stand in an empty placeholder. Safe: it is
# overwritten by the real README in `COPY . .` further down, before the file is
# ever read. Permanent by design (mirrors the main Dockerfile's identical
# `touch`); not a temporary workaround, since the `*.md` exclusion is
# intentional, so no removal TODO.
RUN touch ./README.md
RUN UV_PYTHON_DOWNLOADS=never uv sync --frozen --no-install-project --no-dev \
    --python /usr/local/bin/python3 \
    --extra all --extra messaging --extra otlp --extra anthropic --extra bedrock \
    --extra azure-identity --extra matrix --extra google-chat --extra fal --extra documents

# ---------- Source code ----------
COPY --chown=hermes:hermes . .

# Web dashboard: the source COPY above already carries hermes_cli/web_dist
# (vite's outDir, which HERMES_WEB_DIST points at) IF it was pre-built into the
# build context. It can't be built here (Tailwind v4's lightningcss +
# @tailwindcss/oxide have no riscv64 napi binary, and there is no riscv64 node
# base image to build them under). The output is arch-independent, so build it
# once on amd64 (`npm run build --workspace web`) and drop hermes_cli/web_dist into
# the context before building; CI does this with an amd64 artifact. Without it,
# the dir is simply absent and the image is dashboard-less (the dashboard
# service is gated off by default via HERMES_DASHBOARD).

# Terminal UI assets build natively: ui-tui uses esbuild, which has first-class
# riscv64 support. Same product build as upstream's frontend_build stage, run
# under --predictable for the V8 reason given at the npm ci step, then laid
# over the source tree where upstream's runtime stage puts it.
RUN node --predictable scripts/build/tui.mjs --source /opt/hermes --out /tmp/products/tui && \
    cp -a /tmp/products/tui/. /opt/hermes/ui-tui/ && \
    rm -rf /tmp/products && echo "RISCV64_TUI_BUILD=ok"

# Optional Photon platform sidecar, installed the same way as upstream.
RUN cd plugins/platforms/photon/sidecar && \
    node --predictable /usr/local/lib/node_modules/npm/bin/npm-cli.js ci --no-audit --fetch-retries=5 && \
    npm cache clean --force

# ---------- Permissions ----------
USER root
RUN chmod -R a+rX /opt/hermes && \
    chown -R hermes:hermes /opt/hermes/.venv /opt/hermes/ui-tui /opt/hermes/gateway /opt/hermes/node_modules

# ---------- Link hermes-agent itself (editable) ----------
# riscv64: replaces upstream's `python -m docker.build_agent` (divergence #7),
# which needs pm. The [project.scripts] entry points (hermes, hermes-agent,
# hermes-acp) land in .venv/bin, where hermes-exec-shim.sh looks for them.
RUN uv pip install --no-cache-dir --no-deps --python /opt/hermes/.venv/bin/python -e "." && \
    test -x /opt/hermes/.venv/bin/hermes

# ---------- Install method, stamp and image provenance ----------
# Same files as upstream's runtime stage, minus the pmRuntime key (no pm
# runtime in this image) and with this image's own name.
RUN set -eu; \
    printf 'docker\n' > /opt/hermes/.install_method; \
    if [ ! -f /opt/hermes/install-stamp.json ]; then \
        printf '{"schemaVersion":2,"commit":"0000000000000000000000000000000000000000","distribution":"docker","source":"fallback","updateMechanism":"external"}\n' \
            > /opt/hermes/install-stamp.json; \
    fi; \
    mkdir -p /etc/hermes; \
    python3 -c 'import json, pathlib, tomllib; project = tomllib.loads(pathlib.Path("/opt/hermes/pyproject.toml").read_text(encoding="utf-8"))["project"]; stamp = json.loads(pathlib.Path("/opt/hermes/install-stamp.json").read_text(encoding="utf-8")); commit = stamp.get("commit"); revision = commit if commit and set(commit) != {"0"} else None; marker = pathlib.Path("/etc/hermes/image-provenance.json"); marker.write_text(json.dumps({"schema": 1, "deployment_kind": "image", "manager": "docker", "image": "gounthar/hermes-agent", "version": project["version"], "revision": revision}, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8"); marker.chmod(0o444)'; \
    mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix; \
    mkdir -p /tmp/hermes-runtime && chmod 0700 /tmp/hermes-runtime

# ---------- Bake build-time git revision ----------
ARG HERMES_GIT_SHA=
RUN if [ -n "${HERMES_GIT_SHA}" ]; then \
        printf '%s\n' "${HERMES_GIT_SHA}" > /opt/hermes/.hermes_build_sha && \
        chown hermes:hermes /opt/hermes/.hermes_build_sha; \
    fi

# ---------- s6-overlay service wiring ----------
COPY docker/s6-rc.d/ /etc/s6-overlay/s6-rc.d/

RUN mkdir -p /etc/cont-init.d && \
    printf '#!/command/with-contenv sh\nexec /opt/hermes/docker/stage2-hook.sh\n' \
        > /etc/cont-init.d/01-hermes-setup && \
    chmod +x /etc/cont-init.d/01-hermes-setup
COPY --chmod=0755 docker/cont-init.d/015-supervise-perms /etc/cont-init.d/015-supervise-perms
COPY --chmod=0755 docker/cont-init.d/02-reconcile-profiles /etc/cont-init.d/02-reconcile-profiles

# ---------- Runtime ----------
ENV HERMES_WEB_DIST=/opt/hermes/hermes_cli/web_dist
ENV HERMES_TUI_DIR=/opt/hermes/ui-tui
ENV HERMES_HOME=/opt/data
ENV HERMES_WRITE_SAFE_ROOT=/opt/data
ENV XDG_RUNTIME_DIR=/tmp/hermes-runtime

COPY --chmod=0755 docker/hermes-exec-shim.sh /opt/hermes/bin/hermes
COPY --chmod=0755 docker/entrypoint-dispatch.sh /opt/hermes/docker/entrypoint-dispatch.sh

ENV PATH="/opt/hermes/bin:/opt/hermes/.venv/bin:/opt/data/.local/bin:${PATH}"
COPY --chmod=0644 docker/profile-hermes-path.sh /etc/profile.d/hermes.sh
RUN mkdir -p /opt/data && rm -f /opt/hermes/.venv/.lock
ENV HERMES_PYTHON=/opt/hermes/.venv/bin/python
VOLUME [ "/opt/data" ]

# Same dispatcher as upstream: execs s6-overlay's /init when PID 1, and runs
# the stage2 bootstrap directly under a foreign init.
ENTRYPOINT [ "/opt/hermes/docker/entrypoint-dispatch.sh" ]
CMD [ ]
